<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.ProductManagementController"
            styleClass="root"
            prefWidth="1280"
            prefHeight="800">

    <!-- === TOPBAR === -->
    <top>
        <StackPane fx:id="topbarContainer"/>
    </top>

    <!-- === CONTENT AREA === -->
    <center>
        <HBox spacing="24">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- === CỘT TRÁI: DANH SÁCH SẢN PHẨM === -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">

                <Label text="Sản phẩm của tôi" styleClass="title-large"/>

                <TableView fx:id="tblItems" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa có sản phẩm nào. Thêm sản phẩm ở khung bên phải."
                               styleClass="text-secondary"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colName"
                                     text="Tên sản phẩm"
                                     prefWidth="140"
                                     minWidth="100"/>
                        <TableColumn fx:id="colDescription"
                                     text="Mô tả"
                                     prefWidth="150"
                                     minWidth="90"/>
                        <TableColumn fx:id="colStartingPrice"
                                     text="Giá khởi điểm"
                                     prefWidth="110"
                                     minWidth="100"
                                     style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="colType"
                                     text="Loại"
                                     prefWidth="90"
                                     minWidth="70"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colStartTime"
                                     text="Bắt đầu"
                                     prefWidth="140"
                                     minWidth="138"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colEndTime"
                                     text="Kết thúc"
                                     prefWidth="140"
                                     minWidth="138"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAuctionStatus"
                                     text="Trạng thái phiên"
                                     prefWidth="130"
                                     minWidth="120"
                                     style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- === CỘT PHẢI: FORM CHI TIẾT === -->
            <VBox styleClass="card" 
                  spacing="16" 
                  prefWidth="380" 
                  minWidth="340" 
                  maxWidth="440">

                <Label text="Thêm / Chỉnh sửa sản phẩm" styleClass="title-medium"/>

                <VBox spacing="6">
                    <Label text="TÊN SẢN PHẨM" styleClass="label-caption"/>
                    <TextField fx:id="txtName" promptText="Nhập tên sản phẩm"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="MÔ TẢ" styleClass="label-caption"/>
                    <TextArea fx:id="txtDescription" 
                              prefRowCount="3" 
                              wrapText="true"
                              promptText="Nhập mô tả sản phẩm"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="GIÁ KHỞI ĐIỂM (VND)" styleClass="label-caption"/>
                    <TextField fx:id="txtStartingPrice"
                               promptText="Nhập giá khởi điểm"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="BƯỚC GIÁ (VND, tùy chọn)" styleClass="label-caption"/>
                    <TextField fx:id="txtMinIncrement"
                               promptText="Để trống = 5% giá khởi điểm"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="LOẠI" styleClass="label-caption"/>
                    <ComboBox fx:id="cbItemType"
                              maxWidth="Infinity"
                              promptText="Chọn loại"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="BẮT ĐẦU" styleClass="label-caption"/>
                    <HBox spacing="8">
                        <DatePicker fx:id="dpStartDate" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtStartTime" prefWidth="80" promptText="HH:mm"/>
                    </HBox>
                </VBox>

                <VBox spacing="6">
                    <Label text="KẾT THÚC" styleClass="label-caption"/>
                    <HBox spacing="8">
                        <DatePicker fx:id="dpEndDate" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtEndTime" prefWidth="80" promptText="HH:mm"/>
                    </HBox>
                </VBox>

                <!-- === ACTION BUTTONS === -->
                <HBox spacing="12">
                    <Button text="+ Thêm"
                            styleClass="btn-outline"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            onAction="#onAddClicked"/>
                    <Button fx:id="btnUpdate"
                            text="Cập nhật"
                            styleClass="btn-primary"
                            maxWidth="Infinity"
                            disable="true"
                            HBox.hgrow="ALWAYS"
                            onAction="#onUpdateClicked"/>
                </HBox>

                <HBox spacing="12">
                    <Button text="Làm mới" 
                            styleClass="btn-text" 
                            onAction="#onClearClicked"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>